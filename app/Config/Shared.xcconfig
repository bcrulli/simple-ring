// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = SimpleRing
PRODUCT_DISPLAY_NAME = SimpleRing
PRODUCT_BUNDLE_IDENTIFIER = com.simplering.app
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// ==========================================
// Platform Configuration
// ==========================================
MACOSX_DEPLOYMENT_TARGET = 14.0

// ==========================================
// App Icon
// ==========================================
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
// Menu bar only: no Dock icon (also avoids a Dock flash at launch)
INFOPLIST_KEY_LSUIElement = YES
INFOPLIST_KEY_NSMicrophoneUsageDescription = SimpleRing uses the microphone for push-to-talk with your doorbell.

// ==========================================
// Entitlements
// ==========================================
CODE_SIGN_ENTITLEMENTS = Config/SimpleRing.entitlements

// ==========================================
// Framework Embedding
// ==========================================
// Ensure SPM binary frameworks (like WebRTC) are embedded in app
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks @loader_path/../Frameworks
ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES